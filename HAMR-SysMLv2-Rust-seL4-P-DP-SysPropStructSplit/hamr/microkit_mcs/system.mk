# Do not edit this file as it will be overwritten if HAMR codegen is rerun

SDDF ?= $(LIONSOS)/dep/sddf
override SDDF := $(abspath $(SDDF))
ifeq ("$(wildcard $(SDDF)/util/util.mk)","")
$(error Set SDDF to a copy of https://github.com/au-ts/sddf, or LIONSOS to a checkout that vendors it at dep/sddf)
endif


# Metaprogram that generates the system description file.
# Override to use an alternative schedule (e.g. monitor.mk).
MSD ?= $(TOP_DIR)/meta.py

# Header files containing config structs whose sizes the sdfgen helper
# needs to calculate. Override to point at a different config header.
SCHEDULER_CONFIG_HEADERS ?= $(TOP_DIR)/scheduler/include/default.user_config.h

# Scheduler C source file compiled into scheduler.elf.
# Override to substitute a different scheduler implementation
# (e.g. one that publishes schedule state for runtime monitoring).
SCHEDULER_C ?= $(TOP_DIR)/scheduler/src/default.scheduler.c


TOOLCHAIN := clang
CC := clang
LD := ld.lld
RANLIB := llvm-ranlib
AR := llvm-ar
OBJCOPY := llvm-objcopy
MICROKIT_TOOL ?= $(MICROKIT_SDK)/bin/microkit
DTC := dtc
PYTHON ?= python3

# Which cargo profile directory the Rust staticlibs land in.  The crate Makefiles'
# default target is build-verus-release, and the *-release targets pass --release, so
# those produce target/<triple>/release; the plain build / build-verus targets do not
# and produce target/<triple>/debug.  The link rules below have to look in whichever
# one RUST_MAKE_TARGET actually populated.
RUST_PROFILE_DIR := $(if $(RUST_MAKE_TARGET),$(if $(filter %-release,$(RUST_MAKE_TARGET)),release,debug),release)

SYSTEM_FILE := arinc_scheduling.system
IMAGE_FILE := loader.img
REPORT_FILE := report.txt

SUPPORTED_BOARDS := qemu_virt_aarch64

include ${SDDF}/tools/make/board/common.mk

SDFGEN_HELPER := $(TOP_DIR)/sdfgen_helper.py

# Macros needed by sdfgen helper to calculate config struct sizes
SDFGEN_UNKOWN_MACROS := MAX_PARTITIONS=61 MAX_SCHEDULE_SLOTS=128

SDDF_CUSTOM_LIBC := 1

LDFLAGS := -L$(BOARD_DIR)/lib -L$(SDDF)/lib
LIBS := -lmicrokit -Tmicrokit.ld libsddf_util_debug.a

SDDF_MAKEFILES := ${SDDF}/util/util.mk \
	${SDDF}/drivers/timer/${TIMER_DRIV_DIR}/timer_driver.mk \
	${SDDF}/drivers/serial/${UART_DRIV_DIR}/serial_driver.mk \
	${SDDF}/serial/components/serial_components.mk

include ${SDDF_MAKEFILES}

# exporting TOP_TYPES_INCLUDE in case other makefiles need it
export TOP_TYPES_INCLUDE = -I$(TOP_DIR)/types/include

CFLAGS += \
	-I$(SDDF)/include \
	-I$(SDDF)/include/microkit \
	-I$(TOP_DIR)/scheduler/include \
	$(TOP_TYPES_INCLUDE) \
	$(MON_CFLAGS) \
	-I$(TOP_DIR)/components/gen_gen/include \
	-I$(TOP_DIR)/components/splitter_splitter/include \
	-I$(TOP_DIR)/components/incx_incx/include \
	-I$(TOP_DIR)/components/clampx_clampx/include \
	-I$(TOP_DIR)/components/decy_decy/include \
	-I$(TOP_DIR)/components/merger_merger/include \
	-I$(TOP_DIR)/components/consume_consume/include \
	-I$(TOP_DIR)/components/test_controller_process_test_controller_thread/include


UTIL_OBJS :=

TYPE_OBJS := \
	sb_queue_SysPropStructSplit_Data_Model_StructXY_1.o \
	sb_queue_int32_t_1.o

# The queue objects as an archive: each protection domain's link pulls in only the
# queues it uses, not every queue in the system
TYPES_LIB := libhamr_types.a


all: cache.o

# Sentinel file whose name encodes a hash of build-affecting variables.
# When any of these change the old sentinel is removed and a new one is created,
# forcing dependent targets to rebuild.
# TESTS, LIST_TESTS, GUMBO_CHECKS, SYSVERIF_CHECKS and PROPTEST_SEED are part of the hash because they
# are patched into an ELF section by the MSD step below (all but TESTS through its
# environment, so a meta.py written before they existed still runs).  Without them,
# changing one leaves this stamp -- and therefore $(SYSTEM_FILE) -- up to date, the
# metaprogram never re-runs, and the image silently keeps running the previous
# selection.  Each is hashed with its name: unlabelled, GUMBO_CHECKS=off and
# SYSVERIF_CHECKS=off hash alike, since an empty variable leaves no trace.
# TESTS reaches the MSD step through its environment ("$$TESTS"), so no character in it is
# re-parsed by the shell; in the hash, a quote is replaced (after %, so no two filters hash
# alike) so it cannot end the quoting.
export TESTS
CHECK_FLAGS_BOARD_MD5:=.hamr_flags-$(shell echo -- ${CFLAGS} ${BOARD} ${MICROKIT_CONFIG} ${MICROKIT_SDK} ${MSD} ${SCHEDULER_C} ${SCHEDULER_CONFIG_HEADERS} 'TESTS=$(subst ',%27,$(subst %,%25,$(TESTS)))' LIST_TESTS=${LIST_TESTS} GUMBO_CHECKS=${GUMBO_CHECKS} SYSVERIF_CHECKS=${SYSVERIF_CHECKS} PROPTEST_SEED=${PROPTEST_SEED}| shasum | sed 's/ *-//')

${CHECK_FLAGS_BOARD_MD5}:
	-rm -f .hamr_flags-*
	touch $@

# The stamp above relinks the images.  It is named .hamr_flags-*, not .board_cflags-*:
# sDDF's own stamp (board/common.mk), which every C object depends on, has that name, and
# each rule deletes its name's stamps, so sharing it made each delete the other and every
# make rebuild everything.  sDDF's hash is taken before CFLAGS is extended above, so it
# does not see a variant's MON_CFLAGS, and every variant builds here: an object compiled
# for one could be linked into another.  So when the final CFLAGS changes, every object
# and archive compiled here is removed before anything is built -- only in the build
# directory, where the top Makefile runs this one (make -C), never in a tree it is run
# from by hand.  sDDF's stamp is created with it: made only once objects exist, it would
# otherwise be newer than all of them on the build after a clean one, and recompile them.
CHECK_CFLAGS_MD5:=.cflags-$(shell echo -- ${CFLAGS} | shasum | sed 's/ *-//')
ifeq ($(CURDIR)$(wildcard $(CHECK_CFLAGS_MD5)),$(abspath $(TOP_BUILD_DIR)))
$(shell find . \( -name '*.o' -o -name '*.a' -o -name '.cflags-*' \) -delete; touch $(CHECK_CFLAGS_MD5) $(CHECK_FLAGS_BOARD_HASH))
endif


vpath %.c $(SDDF) \
	$(TOP_DIR)/scheduler/src \
	$(TOP_DIR)/types/src \
	$(TOP_DIR)/components/gen_gen/src \
	$(TOP_DIR)/components/splitter_splitter/src \
	$(TOP_DIR)/components/incx_incx/src \
	$(TOP_DIR)/components/clampx_clampx/src \
	$(TOP_DIR)/components/decy_decy/src \
	$(TOP_DIR)/components/merger_merger/src \
	$(TOP_DIR)/components/consume_consume/src \
	$(TOP_DIR)/components/test_controller_process_test_controller_thread/src


# EXTRA_IMAGES: protection domains only a variant has (the test controller, set by
# test_scheduler.mk); empty for the shipped image
IMAGES := timer_driver.elf scheduler.elf \
	gen_gen.elf \
	gen_gen_MON.elf \
	splitter_splitter.elf \
	splitter_splitter_MON.elf \
	incx_incx.elf \
	incx_incx_MON.elf \
	clampx_clampx.elf \
	clampx_clampx_MON.elf \
	decy_decy.elf \
	decy_decy_MON.elf \
	merger_merger.elf \
	merger_merger_MON.elf \
	consume_consume.elf \
	consume_consume_MON.elf \
	$(EXTRA_IMAGES)

${IMAGES}: libsddf_util_debug.a ${CHECK_FLAGS_BOARD_MD5}


# user code
gen_gen_rust:
	make -C ${CRATES_DIR}/gen_gen $(RUST_MAKE_TARGET)

# user code
splitter_splitter_rust:
	make -C ${CRATES_DIR}/splitter_splitter $(RUST_MAKE_TARGET)

# user code
incx_incx_rust:
	make -C ${CRATES_DIR}/incx_incx $(RUST_MAKE_TARGET)

# user code
clampx_clampx_rust:
	make -C ${CRATES_DIR}/clampx_clampx $(RUST_MAKE_TARGET)

# user code
decy_decy_rust:
	make -C ${CRATES_DIR}/decy_decy $(RUST_MAKE_TARGET)

# user code
merger_merger_rust:
	make -C ${CRATES_DIR}/merger_merger $(RUST_MAKE_TARGET)

# user code
consume_consume_rust:
	make -C ${CRATES_DIR}/consume_consume $(RUST_MAKE_TARGET)

# user code
test_controller_process_test_controller_thread_rust:
	make -C ${CRATES_DIR}/test_controller $(RUST_MAKE_TARGET)

%.o: %.c ${SDDF}/include
	${CC} ${CFLAGS} -c -o $@ $<

SCHEDULER_OBJ := $(notdir $(basename $(SCHEDULER_C))).o

$(SCHEDULER_OBJ): $(SCHEDULER_C) ${SDDF}/include
	${CC} ${CFLAGS} -c -o $@ $<

$(TYPES_LIB): $(TYPE_OBJS)
	rm -f $@
	$(AR) rcs $@ $^

scheduler.elf: $(UTIL_OBJS) $(SCHEDULER_OBJ) $(TYPES_LIB) ${CHECK_FLAGS_BOARD_MD5}
	$(LD) $(LDFLAGS) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -o $@

gen_gen_MON.elf: gen_gen_MON_user.o gen_gen_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

gen_gen.elf: $(UTIL_OBJS) gen_gen_rust gen_gen.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/gen_gen/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -lgen_gen -o $@

splitter_splitter_MON.elf: splitter_splitter_MON_user.o splitter_splitter_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

splitter_splitter.elf: $(UTIL_OBJS) splitter_splitter_rust splitter_splitter.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/splitter_splitter/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -lsplitter_splitter -o $@

incx_incx_MON.elf: incx_incx_MON_user.o incx_incx_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

incx_incx.elf: $(UTIL_OBJS) incx_incx_rust incx_incx.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/incx_incx/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -lincx_incx -o $@

clampx_clampx_MON.elf: clampx_clampx_MON_user.o clampx_clampx_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

clampx_clampx.elf: $(UTIL_OBJS) clampx_clampx_rust clampx_clampx.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/clampx_clampx/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -lclampx_clampx -o $@

decy_decy_MON.elf: decy_decy_MON_user.o decy_decy_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

decy_decy.elf: $(UTIL_OBJS) decy_decy_rust decy_decy.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/decy_decy/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -ldecy_decy -o $@

merger_merger_MON.elf: merger_merger_MON_user.o merger_merger_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

merger_merger.elf: $(UTIL_OBJS) merger_merger_rust merger_merger.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/merger_merger/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -lmerger_merger -o $@

consume_consume_MON.elf: consume_consume_MON_user.o consume_consume_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

consume_consume.elf: $(UTIL_OBJS) consume_consume_rust consume_consume.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/consume_consume/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -lconsume_consume -o $@

test_controller_process_test_controller_thread_MON.elf: test_controller_process_test_controller_thread_MON_user.o test_controller_process_test_controller_thread_MON.o
	$(LD) $(LDFLAGS) $^ $(LIBS) -o $@

test_controller_process_test_controller_thread.elf: $(UTIL_OBJS) test_controller_process_test_controller_thread_rust test_controller_process_test_controller_thread.o $(TYPES_LIB)
	$(LD) $(LDFLAGS) -L ${CRATES_DIR}/test_controller/target/aarch64-unknown-none/$(RUST_PROFILE_DIR) $(filter %.o, $^) $(TYPES_LIB) $(LIBS) -ltest_controller -o $@



$(SYSTEM_FILE): $(IMAGES) $(DTB) ${CHECK_FLAGS_BOARD_MD5}
	$(PYTHON) $(SDFGEN_HELPER) --macros "$(SDFGEN_UNKOWN_MACROS)" --configs "$(SCHEDULER_CONFIG_HEADERS)" --output $(TOP_BUILD_DIR)/config_structs.py
	LIST_TESTS="$(LIST_TESTS)" GUMBO_CHECKS="$(GUMBO_CHECKS)" SYSVERIF_CHECKS="$(SYSVERIF_CHECKS)" PROPTEST_SEED="$(PROPTEST_SEED)" $(PYTHON) $(MSD) --sddf $(SDDF) --board $(MICROKIT_BOARD) --dtb $(DTB) --output . --sdf $(SYSTEM_FILE) --objcopy $(OBJCOPY) --tests="$$TESTS"
	$(OBJCOPY) --update-section .device_resources=timer_driver_device_resources.data timer_driver.elf
	$(OBJCOPY) --update-section .timer_client_config=timer_client_scheduler.data scheduler.elf

$(IMAGE_FILE) $(REPORT_FILE): $(IMAGES) $(SYSTEM_FILE)
	$(MICROKIT_TOOL) $(SYSTEM_FILE) --search-path $(TOP_BUILD_DIR) --board $(MICROKIT_BOARD) --config $(MICROKIT_CONFIG) -o $(IMAGE_FILE) -r $(REPORT_FILE)


FORCE:

qemu:
	$(QEMU) -nographic $(QEMU_ARCH_ARGS)

clean::
	${RM} -f *.elf .depend* $
	find . -name \*.[do] |xargs --no-run-if-empty rm

clobber:: clean
	rm -f *.a
	rm -f ${IMAGE_FILE} ${REPORT_FILE}

test:: 
	make -C ${CRATES_DIR}/gen_gen test
	make -C ${CRATES_DIR}/splitter_splitter test
	make -C ${CRATES_DIR}/incx_incx test
	make -C ${CRATES_DIR}/clampx_clampx test
	make -C ${CRATES_DIR}/decy_decy test
	make -C ${CRATES_DIR}/merger_merger test
	make -C ${CRATES_DIR}/consume_consume test

clean:: 
	make -C ${CRATES_DIR}/gen_gen clean
	make -C ${CRATES_DIR}/splitter_splitter clean
	make -C ${CRATES_DIR}/incx_incx clean
	make -C ${CRATES_DIR}/clampx_clampx clean
	make -C ${CRATES_DIR}/decy_decy clean
	make -C ${CRATES_DIR}/merger_merger clean
	make -C ${CRATES_DIR}/consume_consume clean
	make -C ${CRATES_DIR}/test_controller clean

verus: 
	make -C ${CRATES_DIR}/gen_gen verus
	make -C ${CRATES_DIR}/splitter_splitter verus
	make -C ${CRATES_DIR}/incx_incx verus
	make -C ${CRATES_DIR}/clampx_clampx verus
	make -C ${CRATES_DIR}/decy_decy verus
	make -C ${CRATES_DIR}/merger_merger verus
	make -C ${CRATES_DIR}/consume_consume verus

verus-sys-proof: 
	make -C ${CRATES_DIR}/sys_nominal_proof all

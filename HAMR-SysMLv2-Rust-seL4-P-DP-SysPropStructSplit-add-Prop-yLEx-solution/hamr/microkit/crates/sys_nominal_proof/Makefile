# Do not edit this file as it will be overwritten if HAMR codegen is rerun

# `make all` (or `make`) verifies the whole crate -- every property plus the
# shared, property-independent Commutativity VCs -- in one `cargo-verus
# verify`. `make <property>` runs `cargo-verus focus` on just that
# property's generated VCs (those of its vc_init / vc_sequential /
# vc_post_pre / vc_non_disabling modules that have any).

ENV_VARS = RUSTC_BOOTSTRAP=1

CARGO_FLAGS = -Z build-std=core,alloc,compiler_builtins \
              -Z build-std-features=compiler-builtins-mem \
              --target aarch64-unknown-none

# Extra options for cargo-verus itself, for every cargo-verus target below.
# Empty by default. For example
#   CARGO_VERUS_OPTS="--fwd-verus-args-to roots"
# forwards SMT_OPTS to this crate only, so its dependencies (notably vstd) are
# verified with Verus' defaults rather than with options meant for this crate.
CARGO_VERUS_OPTS ?=

# Extra arguments forwarded to Verus (placed after `--`), for every
# cargo-verus target below. These apply to dependency crates too -- notably
# vstd, which is verified from source on a clean build, so its proofs must
# discharge under these settings as well as our own.
#
# --rlimit 100
#   Verus' SMT resource limit for a function body check. Its default of 10
#   is not enough here. 100 is an order-of-magnitude bump that stays inside
#   the range Verus itself uses on its heavier projects.
#
# --smt-option smt.random_seed=7
#   7 is arbitrary. Z3's default seed is 0, and 0 is the one value at which
#   vstd's GhostSubseq::agree_map (resource/impls/seq.rs) fails its
#   postcondition; seeds 1, 2, 3, 7 and 42 all discharge it. The point is to
#   be off the default and identical on every machine, not this number.
SMT_OPTS ?= --rlimit 100 --smt-option smt.random_seed=7

# Run before every cargo-verus verify target below. cargo-verus caches
# verification like any build: with nothing changed, `cargo-verus verify`
# finishes without re-verifying and prints no `verification results::`
# line. Removing only this crate's dev-profile artifacts makes each run
# re-verify this crate and print its results; its dependencies (notably
# vstd), the release build and the test/coverage artifacts are kept.
VERUS_FRESH = $(ENV_VARS) cargo clean --quiet -p sys_nominal_proof --profile dev $(CARGO_FLAGS)

# The same for the per-property targets: `cargo-verus focus` builds under
# target/verus-partial, apart from `cargo-verus verify`.
VERUS_FRESH_FOCUS = $(ENV_VARS) cargo clean --quiet -p sys_nominal_proof --profile dev --target-dir target/verus-partial $(CARGO_FLAGS)

# verify the entire crate (every property plus the shared Commutativity VCs)
.PHONY: all
all:
	$(VERUS_FRESH)
	$(ENV_VARS) cargo-verus verify $(CARGO_VERUS_OPTS) $(CARGO_FLAGS) -- $(SMT_OPTS)

# verify only property 'gen_range_sanity'
.PHONY: gen_range_sanity
gen_range_sanity:
	$(VERUS_FRESH_FOCUS)
	$(ENV_VARS) cargo-verus focus $(CARGO_VERUS_OPTS) $(CARGO_FLAGS) -- $(SMT_OPTS) --verify-module gen_range_sanity::vc_init --verify-module gen_range_sanity::vc_sequential --verify-module gen_range_sanity::vc_post_pre --verify-module gen_range_sanity::vc_non_disabling

# verify only property 'merged_in_consume_range'
.PHONY: merged_in_consume_range
merged_in_consume_range:
	$(VERUS_FRESH_FOCUS)
	$(ENV_VARS) cargo-verus focus $(CARGO_VERUS_OPTS) $(CARGO_FLAGS) -- $(SMT_OPTS) --verify-module merged_in_consume_range::vc_init --verify-module merged_in_consume_range::vc_sequential --verify-module merged_in_consume_range::vc_post_pre --verify-module merged_in_consume_range::vc_non_disabling

# verify only property 'end_to_end_functional'
.PHONY: end_to_end_functional
end_to_end_functional:
	$(VERUS_FRESH_FOCUS)
	$(ENV_VARS) cargo-verus focus $(CARGO_VERUS_OPTS) $(CARGO_FLAGS) -- $(SMT_OPTS) --verify-module end_to_end_functional::vc_init --verify-module end_to_end_functional::vc_sequential --verify-module end_to_end_functional::vc_post_pre --verify-module end_to_end_functional::vc_non_disabling

# verify only property 'consume_range_loop_invariant'
.PHONY: consume_range_loop_invariant
consume_range_loop_invariant:
	$(VERUS_FRESH_FOCUS)
	$(ENV_VARS) cargo-verus focus $(CARGO_VERUS_OPTS) $(CARGO_FLAGS) -- $(SMT_OPTS) --verify-module consume_range_loop_invariant::vc_init --verify-module consume_range_loop_invariant::vc_sequential --verify-module consume_range_loop_invariant::vc_post_pre --verify-module consume_range_loop_invariant::vc_non_disabling

# verify only property 'y_stays_strictly_below_x'
.PHONY: y_stays_strictly_below_x
y_stays_strictly_below_x:
	$(VERUS_FRESH_FOCUS)
	$(ENV_VARS) cargo-verus focus $(CARGO_VERUS_OPTS) $(CARGO_FLAGS) -- $(SMT_OPTS) --verify-module y_stays_strictly_below_x::vc_init --verify-module y_stays_strictly_below_x::vc_sequential --verify-module y_stays_strictly_below_x::vc_post_pre --verify-module y_stays_strictly_below_x::vc_non_disabling

.PHONY: clean
clean:
	cargo clean
